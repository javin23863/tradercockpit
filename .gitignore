# NOTE: gitignore has no trailing comments — a "#" after a pattern becomes part of it.

# This repo is PUBLIC and serves docs/ via GitHub Pages. Everything else moved to
# the private tradercockpit-ops repo (E18, 2026-07-26), so the long list of
# ignore patterns for productions/, studio-kit/, tools/ and the credential files
# went with it — those patterns belong beside the content they protect.
#
# The credential entries in particular MUST exist in tradercockpit-ops:
#   tools/token.json, tools/token_channel.json, tools/client_secret.json
# They were never committed here and must never be committed there either.

# python
__pycache__/
*.pyc

# knowledge graph outputs — regenerable
graphify-out/

# OS noise
Thumbs.db
.DS_Store
